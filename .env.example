# Submissions Hub — environment variables
# Copy to .env.local for local dev; set the same in Vercel → Settings → Environment Variables.

# --- Database ---
# Set automatically when you add Neon in Vercel → Storage. Locally, any Postgres works:
DATABASE_URL=postgres://localhost/submissions_hub_dev

# --- Admin login (one shared account) ---
ADMIN_USERNAME=
# From: npm run hash-password
ADMIN_PASSWORD_HASH=
# From: npm run secrets (32+ characters). Changing it signs everyone out.
SESSION_SECRET=

# --- Ingest: how each project proves it's allowed to send ---
# Server-to-server keys (from: npm run secrets). Give each project its own key as HUB_INGEST_KEY.
INGEST_KEY_2W=
INGEST_KEY_4W=
INGEST_KEY_ROADSHIELD=
# Optional: allow a browser to post directly from these site addresses (comma-separated).
# Not needed — 2W now sends from its own server route with INGEST_KEY_2W.
INGEST_ORIGINS_2W=
